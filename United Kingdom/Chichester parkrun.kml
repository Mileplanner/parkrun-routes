<?xml version="1.0" encoding="UTF-8"?><kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>Chichester parkrun</name><description/><Style id="icon-1219-normal"><IconStyle><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/1219-fac-wc-unisex.png</href></Icon></IconStyle><LabelStyle><scale>0</scale></LabelStyle></Style><Style id="icon-1219-highlight"><IconStyle><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/1219-fac-wc-unisex.png</href></Icon></IconStyle><LabelStyle><scale>1.1</scale></LabelStyle></Style><StyleMap id="icon-1219"><Pair><key>normal</key><styleUrl>#icon-1219-normal</styleUrl></Pair><Pair><key>highlight</key><styleUrl>#icon-1219-highlight</styleUrl></Pair></StyleMap><Style id="icon-1453-normal"><IconStyle><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/1453-trans-parking.png</href></Icon></IconStyle><LabelStyle><scale>0</scale></LabelStyle></Style><Style id="icon-1453-highlight"><IconStyle><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/1453-trans-parking.png</href></Icon></IconStyle><LabelStyle><scale>1.1</scale></LabelStyle></Style><StyleMap id="icon-1453"><Pair><key>normal</key><styleUrl>#icon-1453-normal</styleUrl></Pair><Pair><key>highlight</key><styleUrl>#icon-1453-highlight</styleUrl></Pair></StyleMap><Style id="icon-503-62AF44-normal"><IconStyle><color>ff44af62</color><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/503-wht-blank_maps.png</href></Icon><hotSpot x="16" xunits="pixels" y="32" yunits="insetPixels"/></IconStyle><LabelStyle><scale>0</scale></LabelStyle></Style><Style id="icon-503-62AF44-highlight"><IconStyle><color>ff44af62</color><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/503-wht-blank_maps.png</href></Icon><hotSpot x="16" xunits="pixels" y="32" yunits="insetPixels"/></IconStyle><LabelStyle><scale>1.1</scale></LabelStyle></Style><StyleMap id="icon-503-62AF44"><Pair><key>normal</key><styleUrl>#icon-503-62AF44-normal</styleUrl></Pair><Pair><key>highlight</key><styleUrl>#icon-503-62AF44-highlight</styleUrl></Pair></StyleMap><Style id="icon-503-DB4436-normal"><IconStyle><color>ff3644db</color><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/503-wht-blank_maps.png</href></Icon><hotSpot x="16" xunits="pixels" y="32" yunits="insetPixels"/></IconStyle><LabelStyle><scale>0</scale></LabelStyle></Style><Style id="icon-503-DB4436-highlight"><IconStyle><color>ff3644db</color><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/503-wht-blank_maps.png</href></Icon><hotSpot x="16" xunits="pixels" y="32" yunits="insetPixels"/></IconStyle><LabelStyle><scale>1.1</scale></LabelStyle></Style><StyleMap id="icon-503-DB4436"><Pair><key>normal</key><styleUrl>#icon-503-DB4436-normal</styleUrl></Pair><Pair><key>highlight</key><styleUrl>#icon-503-DB4436-highlight</styleUrl></Pair></StyleMap><Style id="icon-991-normal"><IconStyle><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/991-biz-cafe.png</href></Icon></IconStyle><LabelStyle><scale>0</scale></LabelStyle></Style><Style id="icon-991-highlight"><IconStyle><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/991-biz-cafe.png</href></Icon></IconStyle><LabelStyle><scale>1.1</scale></LabelStyle></Style><StyleMap id="icon-991"><Pair><key>normal</key><styleUrl>#icon-991-normal</styleUrl></Pair><Pair><key>highlight</key><styleUrl>#icon-991-highlight</styleUrl></Pair></StyleMap><Style id="line-4186F0-5263-nodesc-normal"><LineStyle><color>fff08641</color><width>5.263</width></LineStyle><BalloonStyle><text><![CDATA[<h3>$[name]</h3>]]></text></BalloonStyle></Style><Style id="line-4186F0-5263-nodesc-highlight"><LineStyle><color>fff08641</color><width>7.8945</width></LineStyle><BalloonStyle><text><![CDATA[<h3>$[name]</h3>]]></text></BalloonStyle></Style><StyleMap id="line-4186F0-5263-nodesc"><Pair><key>normal</key><styleUrl>#line-4186F0-5263-nodesc-normal</styleUrl></Pair><Pair><key>highlight</key><styleUrl>#line-4186F0-5263-nodesc-highlight</styleUrl></Pair></StyleMap><Folder><name>Course</name><Placemark><name>Chichester Rugby Club</name><description>Free Parking until 11am. In the near future this will become pay and display.</description><styleUrl>#icon-1453</styleUrl><Point><coordinates>            -0.777186,50.847729,0          </coordinates></Point></Placemark><Placemark><name>Northgate Car park</name><description>£1.50 for 2 hours. Correct 28 May 2016.</description><styleUrl>#icon-1453</styleUrl><Point><coordinates>            -0.777586,50.841713,0          </coordinates></Point></Placemark><Placemark><name>Cafe</name><description>We have organised a mobile coffee van to come to our parkrun most Saturdays. Please make use of him and join in the friendly social atmosphere at the Start / Finish area.</description><styleUrl>#icon-991</styleUrl><Point><coordinates>            -0.778039,50.843156,0          </coordinates></Point></Placemark><Placemark><name>Toilets</name><description>Northgate Car Park Public Toilets</description><styleUrl>#icon-1219</styleUrl><Point><coordinates>            -0.778136,50.841068,0          </coordinates></Point></Placemark><Placemark><name>Finish</name><description>After completing 3 laps enter the finish funnel</description><styleUrl>#icon-503-DB4436</styleUrl><Point><coordinates>            -0.778578,50.843337,0          </coordinates></Point></Placemark><Placemark><name>Start</name><description><![CDATA[The course is 3 laps of Oaklands Park. It is undulating, predominately grass with a compact gravel path and tarmac section.<br><br>Starting near the Chichester Festival Theatre (marked by the green pin) runners track east to the archery field boundary before u turning towards the south west corner of the park. Keeping the tarmac path on your left proceed uphill to the large Beech tree with protected fence.<br><br>At the tree join the compact gravel path heading east before exiting with large planter boxes to your right. After those containers turn left and navigate clockwise around the outside of the rugby pitch ahead. On completion of the 3rd side turn left, route north, pass the Cricket and Rugby pavilions following the perimeter of the park anti-clockwise back to the start.<br><br>Caution is advised in the north west corner when joining the tarmac path through the large gap in the hedge to avoid the bench, pedestrians and cyclists. At the bottom of the hill turn left back to the start. Complete 3 laps before heading into the finish funnel (marked by the red pin).]]></description><styleUrl>#icon-503-62AF44</styleUrl><Point><coordinates>            -0.778512,50.843362,0          </coordinates></Point></Placemark><Placemark><name>Course</name><styleUrl>#line-4186F0-5263-nodesc</styleUrl><LineString><tessellate>1</tessellate><coordinates>            -0.778515,50.843369,0            -0.777092,50.843522,0            -0.77684,50.843576,0            -0.776776,50.843592,0            -0.776772,50.843622,0            -0.77679,50.843643,0            -0.776943,50.843638,0            -0.777225,50.843602,0            -0.778203,50.843466,0            -0.778688,50.843434,0            -0.778773,50.843446,0            -0.778817,50.843468,0            -0.778834,50.843507,0            -0.778853,50.844471,0            -0.778836,50.844507,0            -0.778801,50.844525,0            -0.778698,50.844558,0            -0.778592,50.844573,0            -0.778529,50.844606,0            -0.778484,50.84462,0            -0.7784,50.84464,0            -0.778008,50.844674,0            -0.777264,50.844736,0            -0.777039,50.844778,0            -0.776998,50.844803,0            -0.776973,50.844836,0            -0.77701,50.845092,0            -0.777043,50.845199,0            -0.777094,50.845327,0            -0.777165,50.8454,0            -0.777332,50.845484,0            -0.777448,50.845981,0            -0.777497,50.846096,0            